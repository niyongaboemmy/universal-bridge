{"value":{"kind":"FETCH","data":{"headers":{},"body":"[{\"id\":1,\"title\":\"Building web apps that work on 3G and a mid-range Android\",\"slug\":\"building-web-apps-for-3g\",\"excerpt\":\"Most of our users are on mid-range phones and patchy networks. Here is the checklist we use so every page loads in seconds.\",\"cover\":null,\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Most people who use the software we build in Rwanda are on a mid-range Android phone, often on 3G or a busy 4G network. If a page needs ten seconds to become usable, many of them simply leave. So we design for that phone first.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Start with a budget\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Every page has a JavaScript budget, measured in CI on the production build. If a change pushes a page over the limit, the build fails. It is much easier to stay fast than to become fast later.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Render on the server\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Text, images and buttons arrive as HTML. The page is readable and usable before any JavaScript runs. Interactive parts load as small islands.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Forms that survive bad networks\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Forms submit even if JavaScript has not loaded yet.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Drafts are saved on the device, so a dropped connection does not lose an application.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Errors are shown next to each field and summarised at the top.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"}],\"listType\":\"bullet\",\"direction\":\"ltr\"},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Test on the real phone\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Emulators help, but nothing replaces a real mid-range phone on a real network. We keep a small device lab in the Coding Hub and test every release on it.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"author\":null,\"publishedAt\":\"2026-09-17T22:00:00.000Z\",\"categories\":[{\"id\":1,\"title\":\"Ubwubatsi\",\"slug\":\"engineering\",\"order\":10,\"updatedAt\":\"2026-10-10T12:05:46.155Z\",\"createdAt\":\"2026-10-09T19:44:18.559Z\"}],\"tags\":[],\"featured\":true,\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T20:16:08.404Z\",\"createdAt\":\"2026-10-09T19:44:20.071Z\",\"_status\":\"published\"},{\"id\":2,\"title\":\"What Rwanda's data protection law means for your software\",\"slug\":\"rwanda-data-protection-law-software\",\"excerpt\":\"Law No. 058/2021 changes how organisations collect, store and share personal data. A practical summary for product owners — not legal advice.\",\"cover\":null,\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Rwanda's Law No. 058/2021 on the protection of personal data and privacy applies to any organisation that processes personal data of people in Rwanda. This is a practical summary for product teams; always confirm details with a legal adviser.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Register as a data controller\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Organisations that process personal data register with the National Cyber Security Authority (NCSA).\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Keep data in Rwanda — or get authorisation\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Personal data must be stored in Rwanda unless the NCSA authorises storage abroad. This affects where your database and file storage live.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collect less, and ask clearly\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Only collect what you need for a stated purpose.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ask for consent in plain language, with an unticked box.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Record what people agreed to, and when.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"}],\"listType\":\"bullet\",\"direction\":\"ltr\"},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Be ready for requests and incidents\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"People can ask to see, correct or delete their data. And a personal-data breach must be reported to the NCSA within 48 hours of becoming aware of it. Build the tools for both before you launch, not after.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"author\":null,\"publishedAt\":\"2026-08-26T22:00:00.000Z\",\"categories\":[{\"id\":2,\"title\":\"Ubucuruzi\",\"slug\":\"business\",\"order\":20,\"updatedAt\":\"2026-10-10T12:05:46.167Z\",\"createdAt\":\"2026-10-09T19:44:18.678Z\"}],\"tags\":[],\"featured\":null,\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T12:05:46.591Z\",\"createdAt\":\"2026-10-09T19:44:20.424Z\",\"_status\":\"published\"},{\"id\":3,\"title\":\"Why Kigali works for European and Gulf software teams\",\"slug\":\"kigali-nearshore-software-teams\",\"excerpt\":\"Full working-day overlap with Europe, three working languages and a fast-growing tech ecosystem.\",\"cover\":null,\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"When companies in Europe and the Gulf look for a delivery partner, time zone and communication matter as much as price.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The same working day\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kigali is UTC+2 all year, with no daylight-saving changes. That means a full overlap with central European working hours and a large overlap with the Gulf. Stand-ups, reviews and demos happen in normal hours on both sides.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Three working languages\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Our teams work in English and French, and in Kinyarwanda with local users.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"An ecosystem that is growing\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Rwanda has invested heavily in connectivity and in Kigali Innovation City, and new engineers graduate every year. Through UB Academy we train some of them ourselves.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"How to start\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The best first step is a small, well-defined project. You see how we work, and we learn your product, before anyone commits to a larger team.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"author\":null,\"publishedAt\":\"2026-07-29T22:00:00.000Z\",\"categories\":[{\"id\":2,\"title\":\"Ubucuruzi\",\"slug\":\"business\",\"order\":20,\"updatedAt\":\"2026-10-10T12:05:46.167Z\",\"createdAt\":\"2026-10-09T19:44:18.678Z\"}],\"tags\":[],\"featured\":null,\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T12:05:46.659Z\",\"createdAt\":\"2026-10-09T19:44:20.465Z\",\"_status\":\"published\"},{\"id\":4,\"title\":\"Hiring your first junior developer: lessons from UB Academy\",\"slug\":\"hiring-your-first-junior-developer\",\"excerpt\":\"What we look for when interns join our teams, and how small companies can help juniors succeed in their first months.\",\"cover\":null,\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Many of the developers we work with started as interns. Here is what we have learned about helping juniors succeed.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Look for learning, not just knowledge\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A portfolio project that the candidate can explain line by line tells you more than a list of frameworks.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Give them a real project and a mentor\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"One clear project with a real user.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A named mentor and a weekly check-in.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Small, frequent reviews instead of one big one at the end.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"}],\"listType\":\"bullet\",\"direction\":\"ltr\"},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Make progress visible\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"We ask interns to demo every two weeks. It builds confidence and catches problems early.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Verify certificates\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Every UB internship and training certificate has a code and a QR code. Employers can check it in seconds at universalbridge.rw/academy/verify.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"author\":null,\"publishedAt\":\"2026-06-18T22:00:00.000Z\",\"categories\":[{\"id\":3,\"title\":\"Ishuri\",\"slug\":\"academy\",\"order\":30,\"updatedAt\":\"2026-10-10T12:05:46.179Z\",\"createdAt\":\"2026-10-09T19:44:18.686Z\"}],\"tags\":[],\"featured\":null,\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T12:05:46.727Z\",\"createdAt\":\"2026-10-09T19:44:20.497Z\",\"_status\":\"published\"}]","status":200,"url":""},"revalidate":4294967294},"lastModified":1791669053940,"tags":["posts","cms"]}