{"value":{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":3,\"title\":\"Why Kigali works for European and Gulf software teams\",\"slug\":\"kigali-nearshore-software-teams\",\"excerpt\":\"Full working-day overlap with Europe, three working languages and a fast-growing tech ecosystem.\",\"cover\":null,\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"When companies in Europe and the Gulf look for a delivery partner, time zone and communication matter as much as price.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The same working day\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kigali is UTC+2 all year, with no daylight-saving changes. That means a full overlap with central European working hours and a large overlap with the Gulf. Stand-ups, reviews and demos happen in normal hours on both sides.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Three working languages\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Our teams work in English and French, and in Kinyarwanda with local users.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"An ecosystem that is growing\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Rwanda has invested heavily in connectivity and in Kigali Innovation City, and new engineers graduate every year. Through UB Academy we train some of them ourselves.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"How to start\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The best first step is a small, well-defined project. You see how we work, and we learn your product, before anyone commits to a larger team.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"author\":null,\"publishedAt\":\"2026-07-29T22:00:00.000Z\",\"categories\":[{\"id\":2,\"title\":\"Entreprise\",\"slug\":\"business\",\"order\":20,\"updatedAt\":\"2026-10-10T12:05:46.167Z\",\"createdAt\":\"2026-10-09T19:44:18.678Z\"}],\"tags\":[],\"featured\":null,\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T12:05:46.659Z\",\"createdAt\":\"2026-10-09T19:44:20.465Z\",\"_status\":\"published\"}","status":200,"url":""},"revalidate":4294967294},"lastModified":1791669055837,"tags":["posts","posts:kigali-nearshore-software-teams","cms"]}