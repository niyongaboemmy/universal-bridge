":\"normal\",\"text\":\"How long we keep it\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Enquiries: 24 months after our last contact.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Unsuccessful applications and CVs: 12 months.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Certificates: permanently, so they can be verified.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"}],\"listType\":\"bullet\",\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Expired records are deleted automatically every month.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Who processes data for us\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"These providers process data on our behalf under contract: Vercel (website hosting), Resend (email delivery), Sentry (error monitoring) and Cloudflare Turnstile (bot protection). Where data leaves Rwanda, we rely on NCSA authorisation and contractual safeguards. Personal data is stored in Rwanda unless the National Cyber Security Authority (NCSA) authorises storage elsewhere.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Your rights\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"You can ask to access, correct or delete your data, or object to how we use it. Email hello@universalbridge.rw and we will reply within the legal deadline. You can also complain to the NCSA.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Security\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Uploads are stored privately and checked for viruses; staff access is limited by role and logged. If a breach affects your data, we notify the NCSA within 48 hours and inform you where required.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"blockName\":null,\"blockType\":\"richText\"}],\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T12:05:49.106Z\",\"createdAt\":\"2026-10-09T19:44:28.600Z\",\"_status\":\"published\"}","status":200,"url":""},"revalidate":4294967294},"lastModified":1791669055700,"tags":["pages","pages:legal-privacy","cms"]}