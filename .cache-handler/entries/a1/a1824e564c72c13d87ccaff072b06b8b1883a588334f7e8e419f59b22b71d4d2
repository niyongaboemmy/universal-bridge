{"value":{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":1,\"title\":\"Building web apps that work on 3G and a mid-range Android\",\"slug\":\"building-web-apps-for-3g\",\"excerpt\":\"Most of our users are on mid-range phones and patchy networks. Here is the checklist we use so every page loads in seconds.\",\"cover\":null,\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Most people who use the software we build in Rwanda are on a mid-range Android phone, often on 3G or a busy 4G network. If a page needs ten seconds to become usable, many of them simply leave. So we design for that phone first.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Start with a budget\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Every page has a JavaScript budget, measured in CI on the production build. If a change pushes a page over the limit, the build fails. It is much easier to stay fast than to become fast later.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Render on the server\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Text, images and buttons arrive as HTML. The page is readable and usable before any JavaScript runs. Interactive parts load as small islands.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Forms that survive bad networks\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Forms submit even if JavaScript has not loaded yet.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Drafts are saved on the device, so a dropped connection does not lose an application.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Errors are shown next to each field and summarised at the top.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"}],\"listType\":\"bullet\",\"direction\":\"ltr\"},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Test on the real phone\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Emulators help, but nothing replaces a real mid-range phone on a real network. We keep a small device lab in the Coding Hub and test every release on it.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\",\"textFormat\":0}],\"direction\":\"ltr\"}},\"author\":null,\"publishedAt\":\"2026-09-17T22:00:00.000Z\",\"categories\":[{\"id\":1,\"title\":\"Ubwubatsi\",\"slug\":\"engineering\",\"order\":10,\"updatedAt\":\"2026-10-10T12:05:46.155Z\",\"createdAt\":\"2026-10-09T19:44:18.559Z\"}],\"tags\":[],\"featured\":true,\"seo\":{\"title\":null,\"description\":null,\"image\":null,\"canonical\":null,\"noindex\":null},\"updatedAt\":\"2026-10-10T20:16:08.404Z\",\"createdAt\":\"2026-10-09T19:44:20.071Z\",\"_status\":\"published\"}","status":200,"url":""},"revalidate":4294967294},"lastModified":1791669055817,"tags":["posts","posts:building-web-apps-for-3g","cms"]}