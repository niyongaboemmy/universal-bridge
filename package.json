{
  "name": "universal-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Bridge Ltd — corporate website and digital platform",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:prod-sql": "bash scripts/prod-sql.sh",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "check:content": "tsx scripts/check-content.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:i18n && pnpm check:content && pnpm check:contrast && pnpm check:csp && pnpm test",
    "prepare": "husky || true",
    "check:csp": "tsx scripts/check-csp.ts",
    "brand:assets": "tsx scripts/build-brand-assets.ts",
    "cert:keygen": "tsx scripts/cert-keygen.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@hookform/resolvers": "^5.9.1",
    "@noble/ed25519": "^3.2.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "^2.0.1",
    "cross-env": "^10.1.0",
    "graphql": "^16.14.2",
    "jose": "6.2.12",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.53.0",
    "minisearch": "^7.2.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "7.0.10",
    "payload": "3.90.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
