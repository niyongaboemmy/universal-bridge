# Copy to .env.local and fill in. Never commit real values.

# --- Required -------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/universal_bridge
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
CRON_SECRET=change-me

# Business settings now live in the office (Settings): sender and inboxes, analytics
# domain, booking link, CRM/team webhooks, virus-scanner host, SSO domains, retention,
# registration and roles. The variables marked (fallback) below are only used while
# the matching setting is empty; leave them out once Settings are filled in.

# Email: Resend (RESEND_API_KEY) or SMTP (e.g. the cPanel mailbox noreply@).
# With neither, emails are written to .data/mail/ instead of being sent.
RESEND_API_KEY=
SMTP_HOST=
# 465 = implicit TLS (default), 587 = STARTTLS. SMTP_SECURE overrides the guess.
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Where replies go when a message doesn't set its own reply-to (e.g. info@).
EMAIL_REPLY_TO=
# (fallback) Settings → Email & inboxes
EMAIL_FROM="Universal Bridge <hello@universalbridge.rw>"
# (fallback) Internal inboxes per department (FR-CON-02) — Settings → Email & inboxes
INBOX_SALES=sales@universalbridge.rw
INBOX_ACADEMY=academy@universalbridge.rw
INBOX_CAREERS=careers@universalbridge.rw
INBOX_PARTNERS=partners@universalbridge.rw
INBOX_PRESS=press@universalbridge.rw
INBOX_SUPPORT=support@universalbridge.rw
# Event registrations (defaults to INBOX_ACADEMY)
INBOX_EVENTS=

# Cloudflare Turnstile. These are Cloudflare's public test keys (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Object storage (S3-compatible). Without S3_BUCKET files are stored on local disk.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate limiting (Upstash). Without these an in-memory limiter is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=change-me

# Certificates (IX-05): Ed25519 private key, 32 bytes hex. Generate with `pnpm cert:keygen`.
CERT_SIGNING_KEY=

# (fallback) Virus scanning (ADR-004), Settings → Uploads. clamd host:port. Empty = scanning skipped (dev only).
CLAMAV_HOST=

# --- Optional -------------------------------------------------------------
SENTRY_DSN=
# (fallback) Settings → Integrations
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_CAL_LINK=universal-bridge/discovery
CRM_WEBHOOK_URL=
TEAM_ALERT_WEBHOOK_URL=

# Dev/CI only: multiply form rate limits (E2E submits many forms from one IP).
RATE_LIMIT_SCALE=1

# --- Admin security (ADM-01) -----------------------------------------------
# Two-step verification: off until set. "required" = every staff account, "enrolled" = opt-in.
MFA_ENFORCEMENT=
# Key for encrypting authenticator secrets. Defaults to one derived from PAYLOAD_SECRET.
MFA_ENCRYPTION_KEY=
# Staff single sign-on: off until SSO_ENABLED=1, then each provider with both values set appears.
SSO_ENABLED=
# Redirect URI to register: {NEXT_PUBLIC_SITE_URL}/api/sso/{google|microsoft}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Entra ID tenant id, or "organizations" for any work account.
MICROSOFT_TENANT_ID=
# (fallback, Settings → Accounts) Only these email domains may use SSO (comma-separated). Empty = any domain with a staff account.
SSO_ALLOWED_DOMAINS=universalbridge.rw

# --- Seeding / development ---------------------------------------------------
SEED_ADMIN_EMAIL=admin@universalbridge.rw
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_INTAKES=
# Set to 1 to stop dev schema auto-push (then use pnpm db:migrate).
PAYLOAD_PUSH=
# Staging: keep search engines out (or Settings → Website).
NOINDEX=
# Escape hatch: start even when the configuration check fails (never in production).
ALLOW_INSECURE_ENV=
